# ==========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ==========================================
APP_NAME="Radar Notícias"
APP_ENV=development # Altere para "production" na HostGator
APP_DEBUG=true      # Altere para false na HostGator
APP_URL=http://localhost:8080 # Ex: https://radar.sqltecnologia.inf.br

# ==========================================
# BANCO DE DADOS (MySQL / MariaDB)
# ==========================================
# No Docker local use: DB_HOST=db
# Na HostGator geralmente usa-se: DB_HOST=localhost
DB_HOST=db
DB_PORT=3306
DB_DATABASE=radar_db
DB_USERNAME=radar_user
DB_PASSWORD=radar_password_secret

# ==========================================
# AUTENTICAÇÃO E SEGURANÇA
# ==========================================
# Token para receber matérias automáticas do Gemini Spark
API_WEBHOOK_TOKEN=insira_um_hash_aleatorio_seguro_aqui

# E-mail corporativo autorizado para o painel de controle
ADMIN_EMAIL=seu_email@sqltecnologia.inf.br

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback # Na HostGator: https://radar...

# ==========================================
# SERVIDOR SMTP (HostGator / E-mail Corporativo)
# ==========================================
MAIL_HOST=mail.sqltecnologia.inf.br
MAIL_PORT=465
MAIL_USERNAME=noticias@sqltecnologia.inf.br
MAIL_PASSWORD=sua_senha_do_email_aqui
MAIL_ENCRYPTION=ssl # ou tls na porta 587
MAIL_FROM_ADDRESS=noticias@sqltecnologia.inf.br
MAIL_FROM_NAME="Radar Notícias"